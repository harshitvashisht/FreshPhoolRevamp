generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

enum ProductCategory {
  STEM
  PUJA
  GARLAND
  PACK
}

enum DeliveryWindow {
  puja
  decorative
}

enum OrderKind {
  one_time
  subscription
  mixed
}

enum OrderStatus {
  payment_pending
  payment_received
  being_prepared
  out_for_delivery
  delivered
  cancelled
}

enum PaymentStatus {
  pending
  cash_on_delivery
  confirmed
  failed
}

enum RecurringStatus {
  pending_payment
  active
  paused
  cancelled
}

enum Cadence {
  one_time
  daily
  weekly
  monthly
}

enum Offering {
  custom
  puja_pack
  garland
  stem
}

enum ProductRequestStatus {
  pending
  contacted
  closed
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phoneE164    String?  @unique
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  member       Member?
  auditLogs    AuditLog[]

  @@map("users")
}

model Member {
  id        String           @id @default(uuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneE164 String           @unique
  name      String
  email     String?
  createdAt DateTime         @default(now())
  addresses Address[]
  orders    Order[]
  recurring RecurringOrder[]
  requests  ProductRequest[]

  @@map("members")
}

model Address {
  id        String   @id @default(uuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  community String
  blockFlat String
  pincode   String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  orders    Order[]

  @@index([memberId])
  @@map("addresses")
}

model Product {
  id         String           @id @default(uuid())
  sku        String?          @unique
  slug       String           @unique
  name       String
  category   ProductCategory
  unit       String
  priceRupee Int?
  imageUrl   String?
  active     Boolean          @default(true)
  sortOrder  Int              @default(0)
  variants   ProductVariant[]
  lines      OrderLine[]
  requests   ProductRequest[]

  @@map("products")
}

model ProductRequest {
  id        String               @id @default(uuid())
  memberId  String
  productId String
  qty       Int
  variant   String?
  status    ProductRequestStatus @default(pending)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  member    Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  product   Product              @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([memberId, createdAt])
  @@index([status, createdAt])
  @@map("product_requests")
}

model ProductVariant {
  id           String  @id @default(uuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size         String?
  durationDays Int?
  cadence      Cadence @default(daily)
  priceRupee   Int
  label        String

  @@index([productId])
  @@map("product_variants")
}

model CatalogSku {
  id             String   @id @default(uuid())
  sku            String   @unique
  sourceCategory String
  name           String
  color          String
  unit           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sourceCategory, name])
  @@map("catalog_skus")
}

model DeliveryZone {
  id       String  @id @default(uuid())
  pincode  String  @unique
  locality String
  active   Boolean @default(true)
  notes    String?

  @@map("delivery_zones")
}

model Order {
  id             String           @id @default(uuid())
  orderNumber    String           @unique
  memberId       String?
  member         Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  addressId      String?
  address        Address?         @relation(fields: [addressId], references: [id], onDelete: SetNull)
  community      String
  blockFlat      String
  kind           OrderKind
  deliveryWindow DeliveryWindow
  status         OrderStatus      @default(payment_pending)
  subtotalRupee  Int
  notes          String?
  items          Json
  paidAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  lines          OrderLine[]
  payments       Payment[]
  invoice        Invoice?
  recurring      RecurringOrder[]

  @@index([memberId])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderLine {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name         String
  qty          Int
  unit         String
  unitPrice    Int
  lineTotal    Int
  cadence      Cadence  @default(one_time)
  durationDays Int      @default(1)
  offering     Offering @default(custom)
  size         String?

  @@index([orderId])
  @@map("order_lines")
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountRupee       Int
  status            PaymentStatus @default(pending)
  provider          String        @default("razorpay")
  providerRef       String?
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  checkoutExpiresAt DateTime?
  invoice           Invoice?
  createdAt         DateTime      @default(now())
  confirmedAt       DateTime?

  @@index([orderId])
  @@map("payments")
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId     String?  @unique
  payment       Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amountRupee   Int
  currency      String   @default("INR")
  issuedAt      DateTime @default(now())

  @@map("invoices")
}

model RecurringOrder {
  id                 String          @id @default(uuid())
  subscriptionNumber String          @unique
  memberId           String?
  member             Member?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  sourceOrderId      String?
  sourceOrder        Order?          @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)
  offering           Offering
  name               String
  size               String?
  qty                Int             @default(1)
  durationDays       Int
  cadence            Cadence
  prepaidAmountRupee Int
  community          String
  blockFlat          String
  status             RecurringStatus @default(pending_payment)
  periodStart        DateTime
  periodEnd          DateTime
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([memberId])
  @@index([status])
  @@map("recurring_orders")
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
